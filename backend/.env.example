# Local PostgreSQL started by docker-compose.postgres.yml
# Do not commit an actual production password.
DMS_DATABASE_URL=postgresql://dms_app:change-me-before-deploying@127.0.0.1:5432/dms

# Required on AWS/production. Generate independently for each environment.
DMS_ENV=development
DMS_JWT_SECRET=development-only-change-this-before-aws-deployment
DMS_JWT_EXPIRE_MINUTES=720
